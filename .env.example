# Database configuration (Neon PostgreSQL or local PostgreSQL)
# DATABASE_URL = Neon pooled URL (for connection pooling in app runtime)
DATABASE_URL="postgresql://user:password@ep-sample-123-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL = Neon direct URL (for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# LLM Configuration
LLM_PROVIDER="gemini"
LLM_API_KEY="your_gemini_api_key_here"
LLM_MODEL="gemini-2.5-flash"

# Development & Test fixture mode
# Set to "true" for deterministic offline fixture testing.
# WARNING: MUST BE "false" IN PRODUCTION OR /api/health AND STARTUP WILL FAIL.
MOCK_LLM="true"

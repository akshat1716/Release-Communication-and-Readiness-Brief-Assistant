# Database configuration (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"
DIRECT_URL="postgresql://username:password@localhost:5432/dbname"

# LLM Configuration
LLM_PROVIDER="gemini"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="gemini-2.5-flash"

# Development & Test fixture mode ("true" for offline mock test, "false" for live API)
MOCK_LLM="true"
